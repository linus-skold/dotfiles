[init]
    defaultBranch = main
[core]
    editor = nvim
    pager = delta
	excludeFile = ~/.gitignore
    autocrlf = input 
    eol = lf

[gpg]
    format = ssh

[gpg "ssh"]
    allowedSignersFile = ~/.ssh/allowed_signers

[commit]
    gpgsign = true

[interactive]
    diffFilter = delta --color-only

[add.interactive]
    useBuiltin = false

[delta]
    navigate = true
    light = false

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[include]
    path = ~/.dot/git/personal

[includeif "gitdir/i:**/work/**"]
    path = ~/.dot/git/work

[include]
    path = ~/.dot/git/alias

[include]
    path = ~/.dot/git/hooks

[url "git@knowgit:knowit/"]
	insteadof = https://github.com/knowit/

[url "ssh://git@knowgit/knowit/"]
	insteadof = ssh://git@github.com/knowit/

